        <span class=sf-dump-str title=\"1911 characters\">                    &lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
        <span class=sf-dump-str title=\"1911 characters\">                    &lt;li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
        <span class=sf-dump-str title=\"1911 characters\">                        Projects solving problems around you through science and social sciences<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
        <span class=sf-dump-str title=\"1911 characters\">                    &lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
